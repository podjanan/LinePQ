# Public LIFF configuration
# Owner dashboard /admin: use a random secret of at least 24 characters
ADMIN_ACCESS_KEY=
# Messaging API user IDs authorized to register barber notification targets
LINE_ADMIN_USER_IDS=
LIFF_ID=1234567890-AbCdEfGh
LINE_CHANNEL_ID=1234567890

# Google Sheets database (share the sheet with the service account email)
GOOGLE_SHEET_ID=replace_with_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=trimly@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Created automatically when a private Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Keep these values secret
LINE_CHANNEL_SECRET=replace_with_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_long_lived_access_token
# Optional fallback target for bookings without a registered barber
LINE_STAFF_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLIPOK_API_KEY=replace_with_slipok_api_key
SLIPOK_BRANCH_ID=replace_with_slipok_branch_id

# Payment display
BANK_NAME=ธนาคารกสิกรไทย
BANK_ACCOUNT_NAME=ชื่อบัญชีของร้าน
BANK_ACCOUNT_NUMBER=000-0-00000-0
PAYMENT_QR_URL=https://your-project.vercel.app/payment-qr.png

# Rich menu installer
LIFF_URL=https://liff.line.me/1234567890-AbCdEfGh
MAP_URL=https://maps.google.com/?q=your-shop
